{
  "name": "bffless",
  "version": "0.3.1",
  "description": "BFFless CLI — proxy rules as code (build, validate, test, decompile)",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bffless/ce.git",
    "directory": "packages/cli"
  },
  "homepage": "https://docs.bffless.app",
  "bugs": {
    "url": "https://github.com/bffless/ce/issues"
  },
  "keywords": [
    "bffless",
    "proxy-rules",
    "cli",
    "backend-for-frontend"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "bffless": "dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./lib": "./dist/lib.js",
    "./harness": "./dist/harness/run-handler.js",
    "./eslint": "./dist/lint/eslint-preset.js",
    "./handlers": "./dist/handlers/types.js"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chokidar": "^4.0.1",
    "commander": "^12.1.0",
    "esbuild": "^0.28.1",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
