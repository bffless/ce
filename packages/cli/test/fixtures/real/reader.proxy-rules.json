            "id": "pick",
            "name": "pick",
            "handlerType": "function_handler",
            "config": {
              "code": "function handler({ steps }) {\n  var rows = (steps && steps.query) || []\n  var q = (rows && rows.length) ? rows[0] : null\n  var rid = q ? (q.recordId || q.id || q._id) : null\n  return {\n    recordId: rid ? String(rid) : '',\n    found: rid ? true : false\n  }\n}\n"
            }
          },
          {
            "id": "update",
            "name": "update",
            "handlerType": "data_update",
            "config": {
              "fields": { "folder": "steps.prep.folder" },
              "recordId": "steps.pick.recordId",
              "schemaId": "d1216df3-9776-4de2-81b0-0343d758f83d",
              "condition": "steps.pick.found"
            }
          },
          {
            "id": "respond",
            "name": "respond",
            "handlerType": "response_handler",
            "config": {
              "body": "{\"ok\":true,\"updated\":{{steps.pick.found}}}",
              "status": 200,
              "headers": { "Cache-Control": "no-store" },
              "condition": "steps.prep.hasUrl",
              "contentType": "application/json"
            }
          },
          {
            "id": "respondNoUrl",
            "name": "respondNoUrl",
            "handlerType": "response_handler",
            "config": {
              "body": "{\"error\":\"url is required\"}",
              "status": 400,
              "headers": { "Cache-Control": "no-store" },
              "condition": "steps.prep.noUrl",
              "contentType": "application/json"
            }
          }
        ],
        "validators": [{ "type": "auth_required", "config": { "allowApiKey": true } }]
      }
    },
    {
      "pathPattern": "/api/counts",
      "method": "GET",
      "targetUrl": "pipeline",
      "stripPrefix": true,
      "order": 11,
      "timeout": 30000,
      "preserveHost": false,
      "forwardCookies": false,
      "proxyType": "pipeline",
      "isEnabled": true,
      "description": "Sidebar badge counts: grouped unread-per-feed (db_aggregate count groupBy feedId, read=false) + starred total. Respond { unreadByFeed: {feedId: n}, starred: n }. auth_required (allowApiKey).",
      "pipelineConfig": {
        "name": "Counts",
        "steps": [
          {
            "id": "unread",
            "name": "unread",
            "handlerType": "db_aggregate",
            "config": {
              "filters": { "read": { "op": "eq", "value": "false" } },
              "groupBy": "feedId",
              "schemaId": "96a1b5e7-96f0-43a4-baa8-2e19b539d07c",
              "operation": "count"
            }
          },
          {
            "id": "starred",
            "name": "starred",
            "handlerType": "db_aggregate",
            "config": {
              "filters": { "starred": { "op": "eq", "value": "true" } },
              "schemaId": "96a1b5e7-96f0-43a4-baa8-2e19b539d07c",
              "operation": "count"
            }
          },
          {
            "id": "unreadStarred",
            "name": "unreadStarred",
            "handlerType": "db_aggregate",
            "config": {
              "filters": { "read": { "op": "eq", "value": "false" }, "starred": { "op": "eq", "value": "true" } },
              "filterLogic": "and",
              "schemaId": "96a1b5e7-96f0-43a4-baa8-2e19b539d07c",
              "operation": "count"
            }
          },
          {
            "id": "shape",
            "name": "shape",
            "handlerType": "function_handler",
            "config": {
              "code": "function handler({ steps }) {\n  var u = (steps && steps.unread && steps.unread.results) || []\n  var map = {}\n  for (var i = 0; i < u.length; i++) {\n    var r = u[i] || {}\n    if (r.key != null) map[r.key] = r.value\n  }\n  var s = (steps && steps.starred && typeof steps.starred.result === 'number') ? steps.starred.result : 0\n  var us = (steps && steps.unreadStarred && typeof steps.unreadStarred.result === 'number') ? steps.unreadStarred.result : 0\n  return { json: JSON.stringify({ unreadByFeed: map, starred: s, unreadStarred: us }) }\n}\n"
            }
          },
          {
            "id": "respond",
            "name": "respond",
            "handlerType": "response_handler",
            "config": {
              "body": "{{{steps.shape.json}}}",
              "status": 200,
              "headers": { "Cache-Control": "no-store" },
              "contentType": "application/json"
            }
          }
        ],
        "validators": [{ "type": "auth_required", "config": { "allowApiKey": true } }]
      }
    },
    {
      "pathPattern": "/api/items/read-all",
      "method": "POST",
      "targetUrl": "pipeline",
      "stripPrefix": true,
      "order": 12,
      "timeout": 30000,
      "preserveHost": false,
      "forwardCookies": false,
      "proxyType": "pipeline",
      "isEnabled": true,
      "description": "Mark all read for a view: POST { view, feedId?, folder? } -> data_update read=true where the view filter matches AND read=false. Folder uses the CE `in` operator over the folder's feed URLs. Respond { updated: n }. auth_required (allowApiKey). bffless/apps reader.",
      "pipelineConfig": {
        "name": "Mark all read",
        "steps": [
          {
            "id": "prep",
            "name": "prep",
            "handlerType": "function_handler",
            "config": {
              "code": "function handler({ request }) {\n  var b = (request && request.body) || {}\n  var view = (typeof b.view === 'string') ? b.view : 'all'\n  var feedId = (typeof b.feedId === 'string') ? b.feedId : ''\n  var folder = (typeof b.folder === 'string') ? b.folder : ''\n  return {\n    view: view, feedId: feedId, folder: folder, yes: true,\n    isAllOrRiver: (view === 'all' || view === 'river'),\n    isStarred: view === 'starred',\n    isFeed: view === 'feed',\n    isFolder: view === 'folder',\n    hasFolder: view === 'folder'\n  }\n}\n"
            }
          },
          {
            "id": "folderFeeds",
            "name": "folderFeeds",
            "handlerType": "data_query",
            "config": {
              "limit": 500,
              "schemaId": "d1216df3-9776-4de2-81b0-0343d758f83d",
              "condition": "steps.prep.hasFolder"
            }
          },
          {
            "id": "folderUrls",
            "name": "folderUrls",
            "handlerType": "function_handler",
            "config": {
              "code": "function handler({ steps }) {\n  var rows = (steps && steps.folderFeeds) || []\n  var target = ((steps && steps.prep && steps.prep.folder) || '').toLowerCase()\n  var out = []\n  for (var i = 0; i < rows.length; i++) {\n    var f = rows[i] && rows[i].folder\n    var u = rows[i] && rows[i].url\n    if (typeof u === 'string' && u && typeof f === 'string' && f.toLowerCase() === target) out.push(u)\n  }\n  return { urls: out, count: out.length }\n}\n",
              "condition": "steps.prep.hasFolder"
            }
          },
          {
            "id": "updAll",
            "name": "updAll",
            "handlerType": "data_update",
            "config": {
              "fields": { "read": "steps.prep.yes" },
              "filters": { "read": { "op": "eq", "value": "false" } },
              "schemaId": "96a1b5e7-96f0-43a4-baa8-2e19b539d07c",
              "condition": "steps.prep.isAllOrRiver"
            }
          },
          {
            "id": "updStarred",
            "name": "updStarred",
            "handlerType": "data_update",
            "config": {
              "fields": { "read": "steps.prep.yes" },
              "filters": {
                "read": { "op": "eq", "value": "false" },
                "starred": { "op": "eq", "value": "true" }
              },
              "schemaId": "96a1b5e7-96f0-43a4-baa8-2e19b539d07c",
              "condition": "steps.prep.isStarred",
              "filterLogic": "and"
            }
          },
          {
            "id": "updFeed",
            "name": "updFeed",
            "handlerType": "data_update",
            "config": {
              "fields": { "read": "steps.prep.yes" },
              "filters": {
                "read": { "op": "eq", "value": "false" },
                "feedId": { "op": "eq", "value": "steps.prep.feedId" }
              },
              "schemaId": "96a1b5e7-96f0-43a4-baa8-2e19b539d07c",
              "condition": "steps.prep.isFeed",
              "filterLogic": "and"
            }
          },
          {
            "id": "updFolder",
            "name": "updFolder",
            "handlerType": "data_update",
            "config": {
              "fields": { "read": "steps.prep.yes" },
              "filters": {
                "read": { "op": "eq", "value": "false" },
                "feedId": { "op": "in", "value": "steps.folderUrls.urls" }
              },
              "schemaId": "96a1b5e7-96f0-43a4-baa8-2e19b539d07c",
              "condition": "steps.prep.isFolder",
              "filterLogic": "and"
            }
          },
          {
            "id": "assemble",
            "name": "assemble",
            "handlerType": "function_handler",
            "config": {
              "code": "function handler({ steps }) {\n  function c(u) { return (u && typeof u.count === 'number') ? u.count : null }\n  var n = c(steps.updAll)\n  if (n == null) n = c(steps.updStarred)\n  if (n == null) n = c(steps.updFeed)\n  if (n == null) n = c(steps.updFolder)\n  if (n == null) n = 0\n  return { updated: n }\n}\n"
            }
          },
          {
            "id": "respond",
            "name": "respond",
            "handlerType": "response_handler",
            "config": {
              "body": "{\"updated\":{{steps.assemble.updated}}}",
              "status": 200,
              "headers": { "Cache-Control": "no-store" },
              "contentType": "application/json"
            }
          }
        ],
        "validators": [{ "type": "auth_required", "config": { "allowApiKey": true } }]
      }
    }
  ]
}
